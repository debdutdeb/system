general {
    interval = 2
}

order += "wireless _first_"
order += "battery all"
order += "disk /"
order += "memory"
# for z in /sys/class/thermal/thermal_zone; do echo "$z: $(cat /$z/type)"; done; # for x86_pkg_temp
order += "cpu_temperature 7"
order += "cpu_usage"
order += "tztime local"

wireless _first_ {
    format_up = "WiFi %quality %ip"
    format_down = "WiFi down"
}

battery all {
    format = "BAT %percentage %remaining"
    format_down = "BAT N/A"
}

disk "/" {
    format = "SSD %avail"
}

memory {
    format = "RAM %available"
}

cpu_temperature 7 {
    format = "CPU %degrees°C"
}

cpu_usage {
    format = "CPU %usage%"
}

tztime local {
    format = "%d %b %H:%M"
}
